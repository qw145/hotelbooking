          "name": "Double booking rejected (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Error code is room_unavailable', function () {",
                  "    pm.expect(pm.response.json().error.code).to.eql('room_unavailable');",
