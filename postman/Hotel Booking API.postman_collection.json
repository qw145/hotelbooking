            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotel_id\": {{hotelId}},\n  \"room_id\": {{roomId}},\n  \"guest_name\": \"Grace Hopper\",\n  \"guest_email\": \"grace@example.com\",\n  \"guests\": 2,\n  \"check_in\": \"2026-03-03\",\n  \"check_out\": \"2026-03-05\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
