    {
      "name": "Bookings",
      "item": [
        {
          "name": "Book a room",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {\n    pm.response.to.have.status(201);\n});\n\nconst body = pm.response.json();\n\npm.test('A booking reference was issued', function () {\n    pm.expect(body.reference).to.match(/^BK-[0-9A-HJKMNP-TV-Z]{8}$/);\n});\n\npm.test('Booking is confirmed', function () {\n    pm.expect(body.status).to.eql('confirmed');\n});\n\npm.test('Nights are calculated', function () {\n    pm.expect(body.nights).to.eql(2);\n});\n\n// Save the reference for the lookup request.\npm.collectionVariables.set('bookingReference', body.reference);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotel_id\": {{hotelId}},\n  \"room_id\": {{roomId}},\n  \"guest_name\": \"Ada Lovelace\",\n  \"guest_email\": \"ada@example.com\",\n  \"guests\": 2,\n  \"check_in\": \"2026-03-01\",\n  \"check_out\": \"2026-03-03\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "description": "Book a room.\n\nAvailability and capacity are re-verified server-side at the moment of booking, so a room taken by another request in the meantime is correctly rejected with 409.\n\nOn success the simulated confirmation email is handed to a background worker and sent after a two-second delay; the response returns immediately."
          },
          "response": []
        },
        {
          "name": "Get booking by reference",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {\n    pm.response.to.have.status(200);\n});\n\nconst body = pm.response.json();\n\npm.test('Reference matches the one that was issued', function () {\n    pm.expect(body.reference).to.eql(pm.collectionVariables.get('bookingReference'));\n});\n\npm.test('Guest details are returned', function () {\n    pm.expect(body.guest_name).to.eql('Ada Lovelace');\n    pm.expect(body.guest_email).to.eql('ada@example.com');\n});\n\npm.test('Room and hotel are resolved', function () {\n    pm.expect(body.room.number).to.be.a('string').and.not.empty;\n    pm.expect(body.hotel.name).to.be.a('string').and.not.empty;\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings/{{bookingReference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings",
                "{{bookingReference}}"
              ]
            },
            "description": "Find booking details based on a booking reference. Lookup is case-insensitive and ignores surrounding whitespace."
          },
          "response": []
        },
