              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {\n    pm.response.to.have.status(200);\n});\n\nconst body = pm.response.json();\n\npm.test('Hotel has exactly 6 rooms', function () {\n    pm.expect(body.rooms.length).to.eql(6);\n});\n\npm.test('Capacities match room types', function () {\n    const expected = { single: 1, double: 2, deluxe: 3 };\n    body.rooms.forEach(function (room) {\n        pm.expect(room.room_type.capacity).to.eql(expected[room.room_type.name]);\n    });\n});"
                ]
              }
