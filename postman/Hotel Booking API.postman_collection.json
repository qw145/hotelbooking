    {
      "name": "Availability",
      "item": [
        {
          "name": "Available rooms for 2 guests",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {\n    pm.response.to.have.status(200);\n});\n\nconst body = pm.response.json();\n\npm.test('Reports 2 nights', function () {\n    pm.expect(body.nights).to.eql(2);\n});\n\npm.test('Every room can hold 2 guests', function () {\n    body.available_rooms.forEach(function (room) {\n        pm.expect(room.capacity).to.be.at.least(2);\n    });\n});\n\npm.test('Single room is excluded', function () {\n    const types = body.available_rooms.map(r => r.room_type.name);\n    pm.expect(types).to.not.include('single');\n});\n\n// Save the first available room for the booking request.\npm.collectionVariables.set('roomId', body.available_rooms[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hotels/{{hotelId}}/availability?check_in=2026-03-01&check_out=2026-03-03&guests=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "hotels",
                "{{hotelId}}",
                "availability"
              ],
              "query": [
                {
                  "key": "check_in",
                  "value": "2026-03-01",
                  "description": "First night, inclusive."
                },
                {
                  "key": "check_out",
                  "value": "2026-03-03",
                  "description": "Checkout day, exclusive."
                },
                {
                  "key": "guests",
                  "value": "2",
                  "description": "Party size, 1 to 3."
                }
              ]
            },
            "description": "Find available rooms between two dates for a given number of people.\n\nDates are half-open: 2026-03-01 to 2026-03-03 occupies the nights of March 1 and March 2."
          },
          "response": []
