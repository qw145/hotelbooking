              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () {\n    pm.response.to.have.status(201);\n});\n\npm.test('Check-in equals the previous checkout', function () {\n    pm.expect(pm.response.json().check_in).to.eql('2026-03-03T00:00:00Z');\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
