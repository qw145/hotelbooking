          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotel_id\": {{hotelId}},\n  \"room_id\": {{roomId}},\n  \"guest_name\": \"Grace Hopper\",\n  \"guest_email\": \"grace@example.com\",\n  \"guests\": 2,\n  \"check_in\": \"2026-03-02\",\n  \"check_out\": \"2026-03-04\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/bookings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "description": "Business rule: a room cannot be double booked for any given night.\n\nThis overlaps the booking made in the previous request (March 2 overlaps nights 1-2), so it must be rejected. Run 'Book a room' first."
          },
          "response": []
        },
